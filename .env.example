# Public site origin (no trailing slash). Enables canonical URLs, og:url and sitemap.xml.
VITE_SITE_URL=

# EmailJS delivers the contact form to your mailbox with no server of your own.
# Values come from the EmailJS dashboard (https://dashboard.emailjs.com):
#   SERVICE_ID  → Email Services → the service connected to the receiving mailbox
#   TEMPLATE_ID → Email Templates → the template that formats the request
#   PUBLIC_KEY  → Account → General → Public Key (safe to ship in the browser)
# Set the recipient to contact@dimenshift.com on the template itself, and restrict
# the allowed domains under Account → Security so only your site can send.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional: a server endpoint receiving project requests as multipart/form-data.
# It takes priority over EmailJS, and is the only way the uploaded files can reach you.
VITE_PROJECT_REQUEST_ENDPOINT=
