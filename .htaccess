# Apache / LiteSpeed config for Hostinger shared hosting.
# (_redirects and _headers are the Netlify/Cloudflare equivalents.)

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always serve over HTTPS on the bare domain: http:// and www. both redirect to https://dimenshift.com
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://dimenshift.com%{REQUEST_URI} [L,R=301]

  # Single-page app: unknown paths (e.g. /contact) are served by index.html; React Router picks the page.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Built JS/CSS have content hashes in their names, so they can be cached for good.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Images, frames and videos rarely change; cache for a week.
  <ElseIf "%{REQUEST_URI} =~ m#^/(media|brand)/#">
    Header set Cache-Control "public, max-age=604800"
  </ElseIf>
  # index.html must always be revalidated so new deploys show up immediately.
  <ElseIf "%{REQUEST_URI} =~ m#(^/$|\.html$)#">
    Header set Cache-Control "no-cache"
  </ElseIf>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
